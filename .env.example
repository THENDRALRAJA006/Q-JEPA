# Environment variable template — copy to .env and fill values
# NEVER commit .env to version control

# API configuration (optional overrides)
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO

# Seeds
DEFAULT_SEED=42

# Optional: external dataset paths (not required — synthetic fallback is used)
# METR_LA_PATH=data/raw/metr-la.h5
# PEMS_BAY_PATH=data/raw/pems-bay.h5

# Optional: live traffic API keys (not required for simulation mode)
# TOMTOM_API_KEY=your_key_here
# HERE_API_KEY=your_key_here

# Google Maps Platform (see docs/GOOGLE_MAPS_SETUP.md)
# SERVER key: used ONLY by FastAPI backend for Routes API (keep private, restrict to IP if static)
GOOGLE_MAPS_SERVER_API_KEY=
# BROWSER key: used ONLY by Streamlit frontend for Maps JS API (restrict by HTTP referrer e.g. localhost:8501/*)
GOOGLE_MAPS_BROWSER_API_KEY=
